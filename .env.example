# ===== Credenciales de Green API =====
# Las encuentras en https://console.green-api.com (dentro de tu instancia)
GREENAPI_ID_INSTANCE=1101000001
GREENAPI_API_TOKEN=pega-aqui-tu-apiTokenInstance

# URLs de tu instancia (aparecen en la consola de Green API).
# Si no las cambias, se usan las genéricas y normalmente funcionan.
GREENAPI_API_URL=https://api.green-api.com
GREENAPI_MEDIA_URL=https://media.green-api.com

# ===== Grupo =====
# chatId del grupo "pdf". El bot SOLO responde ahí.
# Se ve así: 120363012345678901@g.us
# Para descubrirlo: deja esto vacío, arranca el bot, sube un archivo al grupo
# y copia el chatId que aparece en la consola. Luego pégalo aquí y reinicia.
ALLOWED_CHAT_ID=

# ===== Opcionales =====
# Ejecutable de Python (debe tener instalado el módulo uno y msoffcrypto-tool).
PYTHON_BIN=python3

# Texto que se envía cuando el archivo viene protegido con contraseña.
PASSWORD_MSG=Error archivo con contraseña

# Segundos de espera de cada consulta de notificaciones (long polling).
RECEIVE_TIMEOUT=15
